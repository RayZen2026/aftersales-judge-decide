# .env 模板 — cp .env.example .env 后填真值（.env 已 gitignore，绝不入库）
# 值来源: 飞书 base 实查 / 需提供

# ── 环境标识（必填）──
# development: 本地开发（使用 DashScope，不调飞书写接口）
# production: 生产部署（使用妙搭降级链，OpenClaw cron，飞书写接口）
# staging: 预发布环境（可选配置）
ENV=development

# ── LLM 后端选择（可选，优先级高于 use_production_chain）──
# dashscope: 开发/测试环境，使用 DashScope qwen-plus-latest
# miaoda: 生产环境，使用妙搭 innerapi 降级链
# 未设置时：根据 config.yaml 中的 use_production_chain 判断
LLM_PROVIDER=dashscope

# ── LLM：Qwen DashScope OpenAI 兼容端点（本地替代妙搭）──
# 申请: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-xxx

# ── 飞书 Bitable app_token ──
# 业务表（任务表）
BITABLE_APP_TOKEN_BUSINESS=U7XQbSEq6axXfJsj2QocRxlQnqb

# 维度表（结果表/商品维度/门店维度）
BITABLE_APP_TOKEN_FIELDS=HGDzb2h7MaydFxsqlyAcCpALnB1

# 规则表（门店分层/判责规则）
BITABLE_APP_TOKEN_RULES=HGDzb2h7MaydFxsqlyAcCpALnB1

# ── 探针输出（project-local；不用生产默认的 ~/.openclaw/tmp/probe-results）──
PROBE_OUTPUT_DIR=./probes
